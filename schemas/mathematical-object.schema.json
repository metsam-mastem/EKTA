{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/metsam-mastem/EKTA/blob/main/schemas/mathematical-object.schema.json",
  "title":"EKTA Universal Mathematical Object",
  "description":"Representation-independent contract for mathematical entities.",
  "type":"object",
  "required":["schema_version","id","kind","identity","revision","semantics","representations"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "id":{"type":"string","pattern":"^UMO-[A-Z0-9][A-Z0-9._-]{2,95}$"},
    "kind":{"type":"string","minLength":2},
    "status":{"type":"string","enum":["DRAFT","PROPOSED","RESEARCHED","VERIFIED","IMPLEMENTED","VALIDATED","BLOCKED","DEPRECATED"]},
    "identity":{"type":"object","required":["canonical_name"],"properties":{"canonical_name":{"type":"string","minLength":2},"aliases":{"type":"array","items":{"type":"string"},"uniqueItems":true},"language":{"type":"string"},"revision":{"type":"string"}},"additionalProperties":true},
    "revision":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "semantics":{"type":"object","required":["definition"],"properties":{"definition":{"type":"string","minLength":8},"scope":{"type":"string"},"notation":{"type":"array","items":{"type":"string"}},"assumptions":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "structure":{"type":"object","properties":{"components":{"type":"array","items":{"type":"object"}},"dimensions":{"type":["integer","array","null"],"minimum":0},"domain":{},"codomain":{},"coordinate_frame_id":{"type":"string"},"attributes":{"type":"object"}},"additionalProperties":true},
    "behavior":{"type":"object","properties":{"operations":{"type":"array","items":{"type":"object"}},"laws":{"type":"array","items":{"type":"string"}},"state_model":{"type":"object"},"input_contract":{"type":"object"},"output_contract":{"type":"object"}},"additionalProperties":true},
    "relations":{"type":"array","items":{"type":"object","required":["predicate","target_id"],"properties":{"predicate":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"target_id":{"type":"string","minLength":1},"context":{"type":"string"},"status":{"type":"string","enum":["PROPOSED","RESEARCHED","VERIFIED"]},"source":{"type":"string"}},"additionalProperties":true}},
    "representations":{"type":"array","minItems":1,"items":{"type":"object","required":["representation_type"],"properties":{"representation_type":{"type":"string","enum":["symbolic","textual","tabular","2d","3d","spatial","graph","procedural","multimodal"]},"media_type":{"type":"string"},"payload":{},"renderer":{"type":"string"},"visual_profile":{"type":"object"}},"additionalProperties":true}},
    "constraints":{"type":"array","items":{"type":"object"}},
    "provenance":{"type":"object","properties":{"sources":{"type":"array","items":{"type":"string","format":"uri-reference"}},"created":{"type":"string","format":"date"},"updated":{"type":"string","format":"date"},"confidence":{"type":"string","enum":["low","medium","high"]}},"additionalProperties":true},
    "extensions":{"type":"object"}
  },
  "additionalProperties":true
}