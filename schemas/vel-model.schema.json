{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metsam-mastem/EKTA/blob/main/schemas/vel-model.schema.json",
  "title": "VEL Engineering Model",
  "description": "Canonical interchange schema for Visual Engineering Language 0.1.",
  "type": "object",
  "required": ["schema_version", "model_id", "name", "revision", "status", "nodes", "connections"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^0\\.1\\.\\d+$"},
    "model_id": {"type": "string", "pattern": "^VEL-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"$ref": "#/$defs/status"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}, "default": []},
    "layers": {"type": "array", "items": {"type": "object"}, "default": []},
    "annotations": {"type": "array", "items": {"type": "object"}, "default": []},
    "metadata": {"type": "object", "default": {}}
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"type": "string", "enum": ["DRAFT", "PROPOSED", "APPROVED", "IMPLEMENTED", "VERIFIED", "BLOCKED", "DEPRECATED"]},
    "port": {
      "type": "object",
      "required": ["id", "name", "direction", "channels"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["IN", "OUT", "INOUT"]},
        "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string"},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "label", "status", "ports"],
      "properties": {
        "id": {"type": "string", "pattern": "^VEL-N-[A-Z0-9][A-Z0-9._-]{1,62}$"},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "layer": {"type": "string"},
        "description": {"type": "string"},
        "ekta_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EKTA-[A-Z]+-\\d{6}$"}},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["node_id", "port_id"],
      "properties": {
        "node_id": {"type": "string"},
        "port_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": ["id", "kind", "source", "target", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^VEL-C-[A-Z0-9][A-Z0-9._-]{1,62}$"},
        "kind": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"},
        "status": {"$ref": "#/$defs/status"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "label", "node_ids"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
