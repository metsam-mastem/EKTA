{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metsam-mastem/EKTA/blob/main/schemas/umsf.schema.json",
  "title": "EKTA UMSF Model",
  "description": "Structural contract for a Universal Multidimensional System Framework model. Cross-record semantic constraints are validated by the runtime validator.",
  "type": "object",
  "required": ["schema_version", "model_id", "root_entity_id", "view_id", "entities", "relationships"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "model_id": {"type": "string", "minLength": 1},
    "root_entity_id": {"type": "string", "minLength": 1},
    "view_id": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "addresses"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x_layer_id", "y_module_id", "z_depth", "valid_from"],
              "properties": {
                "x_layer_id": {"type": "string", "minLength": 1},
                "y_module_id": {"type": "string", "minLength": 1},
                "z_depth": {"type": "integer", "minimum": 0},
                "valid_from": {"type": "string", "format": "date-time"},
                "valid_to": {"type": ["string", "null"], "format": "date-time"}
              },
              "additionalProperties": false
            }
          },
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "predicate", "target_id"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "context": {"type": "string"},
          "status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "provenance": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
