{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metsam-mastem/EKTA/blob/main/schemas/workstream-registry.schema.json",
  "title": "EKTA Workstream Registry",
  "type": "object",
  "required": ["registry_version", "repository", "canonical_branch", "updated_at", "policy", "workstreams"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "repository": {"const": "metsam-mastem/EKTA"},
    "canonical_branch": {"const": "main"},
    "updated_at": {"type": "string", "format": "date"},
    "policy": {"type": "object", "required": ["canonical_writes", "merge_policy", "status_vocabulary", "evidence_rule"], "properties": {
      "canonical_writes": {"type": "string", "minLength": 1},
      "merge_policy": {"type": "string", "minLength": 1},
      "status_vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "evidence_rule": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "workstreams": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "name", "pr", "branch", "status", "priority", "lane", "owner_gate", "dependencies", "outputs", "next", "evidence", "risk"],
      "properties": {
        "id": {"type": "string", "pattern": "^WS-[A-Z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "pr": {"type": "integer", "minimum": 1},
        "branch": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "lane": {"type": "string", "minLength": 1},
        "owner_gate": {"type": "boolean"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "next": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
